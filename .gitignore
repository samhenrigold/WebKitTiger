# Sibling WebKit worktrees (their own repos, like /WebKit/), scratch sysroots,
# and the second CMake build root.
/WebKit-jsc64/
/WebKit-ipc/
/sysroot-new/
/sysroot-old/
/toolchain/sysroot-x86_64/
/build-wkcmake/

# Cross-compiled test binaries; each has its source next to it.
