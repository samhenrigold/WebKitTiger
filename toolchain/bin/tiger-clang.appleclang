#!/bin/sh
WKT=/Users/shg/Developer/WebKitTiger
exec clang -target i386-apple-macosx10.4 -isysroot $WKT/sdk/MacOSX10.4u.sdk -mmacosx-version-min=10.4 -fno-stack-protector --ld-path=$WKT/toolchain/cctools/bin/i386-apple-darwin8-ld -include $WKT/compat/include/tigerprelude.h -I$WKT/toolchain/sysroot-i386/usr/include -L$WKT/toolchain/sysroot-i386/usr/lib "$@"
