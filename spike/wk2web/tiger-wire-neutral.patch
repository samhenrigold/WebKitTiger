--- a/Source/cmake/OptionsTigerProcesses.cmake
+++ b/Source/cmake/OptionsTigerProcesses.cmake
@@ -160,7 +160,19 @@
 macro(TIGER_SET_SHARED_FEATURE _name _value)
     list(FIND _WEBKIT_AVAILABLE_OPTIONS ${_name} _tiger_idx)
     if (_tiger_idx EQUAL -1)
+        # Not a CMake option, so it is a macro one of the PlatformEnable*.h files
+        # defines. Recording it and moving on was wrong: the header then defines it
+        # from PLATFORM(MAC)/PLATFORM(COCOA), which is true on i386 and false on
+        # x86_64, and the two processes compile different serializer sets out of
+        # the same generated text. Writing it into cmakeconfig.h instead gives both
+        # sides the same value, because every one of these headers guards its
+        # define with #if !defined(NAME).
+        #
+        # The ones that are NOT so guarded cannot be fixed from here at all and are
+        # neutralised in the headers themselves; see the PLATFORM(TIGER) block at
+        # the end of PlatformUse.h / PlatformHave.h / PlatformEnable*.h.
         list(APPEND TIGER_NON_OPTION_FEATURES ${_name})
+        SET_AND_EXPOSE_TO_BUILD(${_name} ${_value})
     else ()
         WEBKIT_OPTION_DEFAULT_PORT_VALUE(${_name} PRIVATE ${_value})
     endif ()
@@ -200,6 +212,33 @@
 # per-process section: all four processes must agree about it.
 TIGER_SET_SHARED_FEATURE(ENABLE_GPU_PROCESS ON)
 
+# Flags that appear in a serialization or messages condition, are derived from
+# PLATFORM(MAC)/PLATFORM(COCOA)/OS(DARWIN), and were measured divergent between
+# build/tiger-gpu and build/tiger-web-port. Off on both sides: none of them
+# carries anything the 64-bit process can produce. See the NOTES table.
+set(TIGER_IPC_MAC_DERIVED_OFF
+    ENABLE_ACCESSIBILITY_ANIMATION_CONTROL
+    ENABLE_APPLE_PAY_NEW_BUTTON_TYPES
+    ENABLE_APPLE_PAY_UPDATE_SHIPPING_METHODS_WHEN_CHANGING_LINE_ITEMS
+    ENABLE_CONTEXT_MENU_QR_CODE_DETECTION
+    ENABLE_DESTINATION_COLOR_SPACE_DISPLAY_P3
+    ENABLE_OPUS
+    ENABLE_REMOTE_INSPECTOR_SERVICE_WORKER_AUTO_INSPECTION
+    ENABLE_VORBIS
+    ENABLE_VP9
+    ENABLE_WHEEL_EVENT_REGIONS
+    HAVE_AUDIO_COMPONENT_SERVER_REGISTRATIONS
+)
+foreach (_tiger_off IN LISTS TIGER_IPC_MAC_DERIVED_OFF)
+    TIGER_SET_SHARED_FEATURE(${_tiger_off} OFF)
+endforeach ()
+unset(_tiger_off)
+
+# The one that diverges the other way: 1 on x86_64, 0 on i386. Aligned up rather
+# than down, because the x86_64 value is the one the loading path has actually
+# been exercised with.
+TIGER_SET_SHARED_FEATURE(ENABLE_ALL_LEGACY_REGISTERED_SPECIAL_URL_SCHEMES ON)
+
 if (TIGER_NON_OPTION_FEATURES)
