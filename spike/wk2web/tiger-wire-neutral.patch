+// TIGER: wire-flag neutralisation for the i386 side of the 10.4 split port.
+//
+// Every macro below is derived from PLATFORM(MAC)/PLATFORM(COCOA)/OS(DARWIN),
+// which are true on this port's i386 process and false on its x86_64 one, AND
+// appears in a *.serialization.in or *.messages.in condition. Left alone, the
+// two processes compile different serializer sets out of byte-identical
+// generated text -- a silent wire corruption that tiger-check-ipc cannot see,
+// because the generated sources match and these are not CMake variables.
+//
+// All of them are off rather than remapped: none carries anything the 64-bit
+// side can produce (no CoreGraphics, no AppKit, no PassKit, no Mach bootstrap,
+// no CoreText font registry), so the neutral value is simply the value the
+// x86_64 side already has. The four that ARE remapped rather than disabled --
+// USE_CG, USE_CF, USE_APPKIT, USE_CORE_TEXT -- are the architecture and are
+// handled by TIGER_WIRE_* in wtf/PlatformTigerWire.h; do not touch them here.
+//
+// Written as one appended block rather than 26 edits to the conditions above
+// on purpose: several of those conditions are multi-line, and a block that
+// simply states the final value is both easier to review and impossible to get
+// subtly wrong. Measured, not reasoned: see the NOTES table.
+#if PLATFORM(TIGER)
+#undef USE_AUDIO_SESSION
+#define USE_AUDIO_SESSION 0
+#undef USE_AUTOMATIC_TEXT_REPLACEMENT
+#define USE_AUTOMATIC_TEXT_REPLACEMENT 0
+#undef USE_DICTATION_ALTERNATIVES
+#define USE_DICTATION_ALTERNATIVES 0
+#undef USE_UNIFIED_TEXT_CHECKING
+#define USE_UNIFIED_TEXT_CHECKING 0
+#endif // PLATFORM(TIGER)
